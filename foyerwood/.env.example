# ---------------------------------------------------------------------------
# Foyerwood — environment variables
# Copy to .env.local for local development. Without DATABASE_URL the app uses
# an embedded PostgreSQL (PGlite) stored in .data/ — perfect to try it out.
# ---------------------------------------------------------------------------

# Public URL of the site (sitemap, canonical URLs, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PostgreSQL connection string. On Vercel, Storage → Neon adds DATABASE_URL
# automatically. With Supabase, use the "Transaction pooler" string (port 6543).
# DATABASE_URL=postgresql://user:PASSWORD@host/db?sslmode=require
# DATABASE_POOL_SIZE=5
# The schema and starter data are created automatically on first start
# (set AUTO_SETUP=false to run `npm run db:migrate` / `npm run db:seed` yourself).
# AUTO_SETUP=true

# Session signing secret for the administration (32+ random characters, REQUIRED in production)
# Generate one with: openssl rand -base64 48
SESSION_SECRET=

# First administrator, created automatically on first start / `npm run db:seed`
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Photos: Vercel Blob (Vercel → Storage → Blob adds BLOB_READ_WRITE_TOKEN), or
# Supabase Storage (public bucket, default name "media")
# BLOB_READ_WRITE_TOKEN=
# NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=media

# Optional starting values copied into the database at seed time
# (all of them can be edited later in Administration → Réglages)
# WHATSAPP_CA=+15145550100
# WHATSAPP_US=+12125550100
# WHATSAPP_FR=+33612345678
# CONTACT_EMAIL=contact@foyerwood.com
# COMPANY_LEGAL_NAME=
# COMPANY_ADDRESS=
